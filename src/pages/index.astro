---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brands } from '../data/brands';
import { kitchens } from '../data/kitchens';
import '../styles/global.css';
---

<BaseLayout>
	<Header />

	<!-- Hero -->
	<section class="max-w-7xl mx-auto px-6 pt-16 pb-20">
		<div class="grid md:grid-cols-2 gap-12 items-center">
			<div>
				<div
					class="inline-flex items-center gap-x-2 bg-red-100 text-[#C8102E] px-4 py-1.5 rounded-3xl text-sm font-semibold mb-6"
				>
					<i class="fa-solid fa-check"></i>
					<span>American Brands • Factory Direct</span>
				</div>

				<h1 class="text-5xl sm:text-6xl md:text-7xl font-semibold tracking-tighter leading-none mb-6">
					Premium American<br />cabinets.<br />
					<span class="text-[#C8102E]">Wholesale prices.</span>
				</h1>

				<p class="max-w-md text-xl text-slate-600 mb-6">
					Stock, semi-custom, and full custom cabinetry delivered nationwide. Built for contractors and
					serious homeowners.
				</p>

				<div class="flex flex-wrap gap-2 mb-8 text-xs sm:text-sm text-slate-600">
					<span class="px-3 py-1.5 bg-white border border-slate-200 rounded-full">Framed &amp; Frameless</span>
					<span class="px-3 py-1.5 bg-white border border-slate-200 rounded-full">Inset Styles</span>
					<span class="px-3 py-1.5 bg-white border border-slate-200 rounded-full">Stains &amp; Paints</span>
					<span class="px-3 py-1.5 bg-white border border-slate-200 rounded-full">All Plywood</span>
					<span class="px-3 py-1.5 bg-white border border-slate-200 rounded-full">Soft-Close</span>
				</div>

				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href="#quote"
						class="px-8 py-4 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-3xl text-lg transition-all flex items-center justify-center gap-x-3 active:scale-[0.985]"
					>
						Get a Free Quote
					</a>
					<a
						href="tel:18774777784"
						class="px-8 py-4 border border-slate-300 hover:bg-white font-semibold rounded-3xl text-lg transition-all flex items-center justify-center gap-x-3"
					>
						<i class="fa-solid fa-phone"></i>
						<span>Call Now</span>
					</a>
				</div>
			</div>

			<div class="relative">
				<img
					src="/images/Home-Display-kitchens/stock-white-shaker.webp"
					alt="CabFabs shaker paint kitchen cabinets"
					class="rounded-3xl shadow-2xl w-full aspect-[4/3] object-cover"
				/>
				<div
					class="absolute bottom-6 right-6 bg-white/95 backdrop-blur px-5 py-3 rounded-2xl shadow-xl border border-slate-100"
				>
					<div class="text-sm font-medium">Starting at</div>
					<div class="text-3xl font-semibold text-[#C8102E]">$2,539</div>
					<div class="text-xs text-slate-500">for a complete 10×10 kitchen</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Trust Bar -->
	<div class="bg-white border-y border-slate-100 py-6">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 text-center">
				<div class="flex flex-col items-center px-2">
					<i class="fa-solid fa-globe text-3xl text-[#C8102E] mb-2"></i>
					<div class="font-semibold">Nationwide Delivery</div>
				</div>
				<div class="flex flex-col items-center px-2">
					<i class="fa-solid fa-shield-halved text-3xl text-[#C8102E] mb-2"></i>
					<div class="font-semibold">Lifetime Warranties</div>
				</div>
				<div class="flex flex-col items-center px-2">
					<i class="fa-solid fa-industry text-3xl text-[#C8102E] mb-2"></i>
					<div class="font-semibold">American Cabinet Brands</div>
				</div>
				<div class="flex flex-col items-center px-2">
					<i class="fa-solid fa-truck-fast text-3xl text-[#C8102E] mb-2"></i>
					<div class="font-semibold">Free Shipping on 10+ Cabinets</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Featured Kitchens -->
	<section id="kitchens" class="max-w-7xl mx-auto px-6 py-20">
		<div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-10">
			<div>
				<h2 class="text-4xl font-semibold tracking-tight">Real kitchens.<br />Real pricing.</h2>
				<p class="text-slate-600 mt-2">
					Complete 10×10 kitchens with all plywood construction and soft-close hardware.
				</p>
			</div>
			<a
				href="https://www.cabinetprosupply.com/name-brand-kitchen-cabinets.html"
				class="text-[#C8102E] font-semibold hover:underline shrink-0">Browse all options →</a
			>
		</div>

		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				kitchens.map((kitchen) => (
					<a
						href="#quote"
						class:list={[
							'cabinet-card bg-white rounded-3xl overflow-hidden border border-slate-200 block',
							kitchen.span && 'md:col-span-2 lg:col-span-1',
						]}
					>
						<img src={kitchen.image} class="w-full h-56 object-cover" alt={kitchen.alt} />
						<div class="p-6">
							<div class="flex justify-between items-start mb-3 gap-3">
								<div>
									<div class="font-semibold text-lg">{kitchen.name}</div>
									<div
										class:list={[
											'text-sm',
											kitchen.eyebrowTone === 'promo'
												? 'text-[#C8102E] font-semibold'
												: 'text-slate-500',
										]}
									>
										{kitchen.eyebrow}
									</div>
								</div>
								<div class="text-right shrink-0">
									<div
										class:list={[
											'font-semibold text-[#C8102E]',
											kitchen.priceNote ? 'text-2xl' : 'text-3xl',
										]}
									>
										{kitchen.price}
									</div>
									<div class="text-xs text-slate-500">
										{kitchen.priceNote ?? '10×10 Kitchen'}
									</div>
								</div>
							</div>
							<ul class="text-sm text-slate-600 space-y-1">
								{kitchen.features.map((feature) => (
									<li>• {feature}</li>
								))}
							</ul>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<!-- Why Us -->
	<section id="why-us" class="bg-white py-20 border-y border-slate-100">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-semibold tracking-tight">Why contractors and homeowners choose us</h2>
				<p class="text-slate-600 mt-3 max-w-2xl mx-auto">
					The right way to buy cabinets — factory-direct pricing, expert support, and delivery nationwide.
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-dollar-sign text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Factory Direct Pricing</h3>
					<p class="text-slate-600">
						Save significantly compared to retail showrooms while getting the same (or better) quality
						cabinets.
					</p>
				</div>
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-tags text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Guaranteed Savings</h3>
					<p class="text-slate-600">
						Our below-retail pricing guarantees you the best value anywhere in the cabinet industry.
					</p>
				</div>
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-tools text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Built for Professionals</h3>
					<p class="text-slate-600">
						Fast, accurate quoting and reliable delivery that contractors depend on.
					</p>
				</div>
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-trophy text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Award-Winning Staff</h3>
					<p class="text-slate-600">
						Top-notch design and sales staff to guide you through the design and ordering process.
					</p>
				</div>
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-user-check text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Individual Approach</h3>
					<p class="text-slate-600">
						One-on-one attention start to finish so your project gets the attention it deserves.
					</p>
				</div>
				<div class="p-8 rounded-3xl border border-slate-200">
					<div class="w-12 h-12 bg-red-100 text-[#C8102E] rounded-2xl flex items-center justify-center mb-5">
						<i class="fa-solid fa-credit-card text-2xl"></i>
					</div>
					<h3 class="font-semibold text-xl mb-3">Flexible Payment Options</h3>
					<p class="text-slate-600">
						We accept all major credit cards and ACH transfers for your convenience.
					</p>
				</div>
			</div>

			<div class="text-center mt-10">
				<a href="/about" class="text-[#C8102E] font-semibold hover:underline"
					>Learn more about how we work →</a
				>
			</div>
		</div>
	</section>

	<!-- Brands -->
	<section id="brands" class="max-w-7xl mx-auto px-6 py-20">
		<div class="text-center mb-12">
			<h2 class="text-4xl font-semibold tracking-tight">Brands we represent</h2>
			<p class="text-slate-600 mt-3 max-w-2xl mx-auto">
				Top-quality American-made cabinet lines for every style, budget, and build type.
			</p>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{
				brands.map((brand) => (
					<div class="bg-white border border-slate-200 rounded-3xl p-6 flex flex-col">
						<div class="h-20 flex items-center justify-center mb-5 rounded-2xl bg-slate-50 border border-slate-100 px-4">
							<img
								src={brand.logo}
								alt={brand.alt}
								class:list={[brand.logoClass, 'w-auto max-w-full object-contain']}
							/>
						</div>
						<div class="text-lg font-semibold text-slate-900 mb-1">{brand.name}</div>
						<p class="text-sm text-slate-600 mb-4 flex-1">{brand.blurb}</p>
						<a
							href={`/brands/${brand.slug}`}
							class="text-sm font-semibold text-[#C8102E] hover:underline"
						>
							View brand →
						</a>
					</div>
				))
			}
		</div>

		<div class="text-center mt-10">
			<a
				href="/brands"
				class="inline-flex px-6 py-3 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-2xl transition-colors"
			>
				Explore All Brands →
			</a>
		</div>
	</section>

	<!-- Pros & DIY -->
	<section class="max-w-7xl mx-auto px-6 py-20">
		<div class="grid md:grid-cols-2 gap-8">
			<div id="pros" class="bg-slate-900 text-white p-10 rounded-3xl scroll-mt-28">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-3">
					FOR TRADE PROFESSIONALS
				</div>
				<h3 class="text-3xl font-semibold mb-4">Built for builders, contractors &amp; designers</h3>
				<ul class="space-y-3 text-slate-300 mb-8">
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Fast, accurate quoting
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Volume pricing available
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Job site delivery
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Dedicated account support
					</li>
				</ul>
				<a
					href="/pros"
					class="inline-block px-6 py-3 bg-white text-slate-900 font-semibold rounded-2xl hover:bg-slate-100 transition-colors"
					>Get Contractor Pricing →</a
				>
			</div>

			<div id="diy" class="bg-white p-10 rounded-3xl border border-slate-200 scroll-mt-28">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">FOR DIY HOMEOWNERS</div>
				<h3 class="text-3xl font-semibold mb-4">High quality without the showroom markup</h3>
				<ul class="space-y-3 text-slate-600 mb-8">
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Full control over your project
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Huge selection of styles &amp; finishes
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Clear pricing with no surprises
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i> Guidance from start to finish
					</li>
				</ul>
				<a
					href="/diy"
					class="inline-block px-6 py-3 border border-slate-300 hover:bg-slate-50 font-semibold rounded-2xl transition-colors"
					>Start Your Project →</a
				>
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section id="testimonials" class="bg-white py-20 border-y border-slate-100">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-semibold tracking-tight">What our customers say</h2>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"I have installed all the cabinets and couldn't be more pleased. When we next remodel, your
						company will be our first call for cabinetry!"
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Paul and Wendy, CA</footer>
				</blockquote>
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"The quality is excellent! Everything is in and it looks great! Thank you for making this a
						seamless process."
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Gabe, IN</footer>
				</blockquote>
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"Being in IT, it was great to work with a home improvement service where you can jot all your
						requirements in email, and the company responds in real time."
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Kelly, CA</footer>
				</blockquote>
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"Ron worked with us on every aspect of the project. He was very knowledgeable about the product
						lines and how to put the whole kitchen together."
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Terry, NY</footer>
				</blockquote>
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"Each time I came back to the project, Ron was responsive and did not treat me as if I was an
						order that would never happen."
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Jody, NY</footer>
				</blockquote>
				<blockquote class="bg-slate-50 border border-slate-200 rounded-3xl p-6">
					<p class="text-slate-700 mb-4">
						"Quick quotes for my estimates, fast turnarounds on revisions, and no hidden costs — great
						benefits to my business."
					</p>
					<footer class="text-sm font-semibold text-[#C8102E]">Chris, WI</footer>
				</blockquote>
			</div>
		</div>
	</section>

	<!-- Quote -->
	<section id="quote" class="bg-[#C8102E] py-16 text-white scroll-mt-28">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-4xl font-semibold tracking-tight mb-3">Ready to get started?</h2>
			<p class="text-red-100 text-xl mb-8">Get a free quote — we usually respond within a few hours.</p>

			<div class="max-w-md mx-auto bg-white rounded-3xl p-8 text-left shadow-xl">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-slate-900 mb-1">Request Your Free Quote</h3>
					<p class="text-sm text-slate-600">Fill out the form below and we'll get back to you shortly.</p>
				</div>
				<div id="hubspot-form">
					<script
						is:inline
						src="https://js-na2.hsforms.net/forms/embed/243338171.js"
						defer></script>
					<div
						class="hs-form-frame"
						data-region="na2"
						data-form-id="33d8738b-cf6c-4b7a-8c52-00d5f5adada7"
						data-portal-id="243338171"
					>
					</div>
				</div>
			</div>

			<p class="text-red-200 text-xs mt-6">
				Your information is secure and will only be used to provide your quote.
			</p>
		</div>
	</section>

	<Footer quoteHref="#quote" />
</BaseLayout>
