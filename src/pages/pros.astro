---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brands } from '../data/brands';
import '../styles/global.css';

const benefits = [
	{
		icon: 'fa-bolt',
		title: 'Fast, accurate quoting',
		body: 'Send plans, a sketch, or a room list — we turn around clear pricing you can use for bids and client presentations.',
	},
	{
		icon: 'fa-tags',
		title: 'Trade & volume pricing',
		body: 'Wholesale pricing structured for contractors, remodelers, and designers who buy kitchens regularly.',
	},
	{
		icon: 'fa-truck',
		title: 'Job site delivery',
		body: 'Cabinets delivered where you need them — homeowner site or jobsite — so your install schedule stays on track.',
	},
	{
		icon: 'fa-headset',
		title: 'Dedicated account support',
		body: 'One team from quote through delivery and warranty. We stay involved until the kitchen is right.',
	},
	{
		icon: 'fa-drafting-compass',
		title: 'Design help when you need it',
		body: 'Layout assistance, catalogs, samples, or a simple quote on a live project — we match the support to how you work.',
	},
	{
		icon: 'fa-users',
		title: 'Client-ready communication',
		body: 'Prefer we speak directly with your customer? We can. Prefer you stay the point of contact? That works too.',
	},
];

const steps = [
	{
		n: '01',
		title: 'Tell us how you work',
		body: 'Builder, remodeler, designer, or installer — we tailor catalogs, samples, and quoting to your operation.',
	},
	{
		n: '02',
		title: 'Send the project',
		body: 'Plans, measurements, brand preference, or a photo of the existing kitchen. We price what you need to win the job.',
	},
	{
		n: '03',
		title: 'Order & deliver',
		body: 'Approve the quote, we place the order, and cabinets ship factory-direct to the site — with support if anything needs fixing.',
	},
];
---

<BaseLayout
	title="For Pros | Contractor & Designer Cabinet Pricing | Cabinet Pro Supply"
	description="Wholesale American cabinets for contractors, builders, and designers. Fast quoting, trade pricing, job site delivery, and dedicated account support from Cabinet Pro Supply."
	canonicalPath="/pros"
>
	<Header />

	<!-- Hero -->
	<section class="relative overflow-hidden bg-slate-900 text-white">
		<div
			class="absolute inset-0 opacity-30"
			style="background-image: url('/images/Home-Display-kitchens/starmark-inset-painted.jpg'); background-size: cover; background-position: center;"
		>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-900/70"></div>

		<div class="relative max-w-7xl mx-auto px-6 py-20 md:py-28">
			<div class="max-w-2xl">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-4">
					FOR TRADE PROFESSIONALS
				</div>
				<h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05] mb-5">
					Your cabinet partner for every job
				</h1>
				<p class="text-lg md:text-xl text-slate-300 mb-8 max-w-xl">
					Wholesale American brands, clear pricing, and support from quote to delivery — built for builders,
					contractors, remodelers, and designers.
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href="#quote"
						class="px-8 py-4 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-3xl text-lg transition-all text-center active:scale-[0.985]"
					>
						Get Contractor Pricing
					</a>
					<a
						href="tel:18774777784"
						class="px-8 py-4 border border-white/30 hover:bg-white/10 font-semibold rounded-3xl text-lg transition-all text-center flex items-center justify-center gap-x-3"
					>
						<i class="fa-solid fa-phone"></i>
						<span>1-877-477-7784</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Intro -->
	<section class="max-w-7xl mx-auto px-6 py-16 md:py-20">
		<div class="grid md:grid-cols-2 gap-12 items-start">
			<div>
				<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-5">
					No one-size-fits-all trade program
				</h2>
				<p class="text-lg text-slate-600 mb-4">
					We’ve worked with a wide range of businesses that sell or install kitchens. There’s no boilerplate
					way to serve everyone — so we stay flexible and build the support around how <em>your</em> company
					runs.
				</p>
				<p class="text-lg text-slate-600">
					Whether you need design help, catalogs and samples, a quick quote on a live job, or a steady
					wholesale partner for every kitchen you sell — we’re set up to earn the business and keep it.
				</p>
			</div>
			<div class="bg-white border border-slate-200 rounded-3xl p-8 md:p-10">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">WHAT YOU GET</div>
				<ul class="space-y-4 text-slate-700">
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i>
						<span>Stock, semi-custom, and full custom lines — so you rarely have to turn down a job</span>
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i>
						<span>American brands with real warranties — we don’t sell lines that won’t stand behind the product</span>
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i>
						<span>Competitive distributor pricing from quote through delivery</span>
					</li>
					<li class="flex gap-x-3">
						<i class="fa-solid fa-check mt-1 text-[#C8102E]"></i>
						<span>Warranty issues handled quickly so your reputation stays intact</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="bg-white border-y border-slate-100 py-16 md:py-20">
		<div class="max-w-7xl mx-auto px-6">
			<div class="max-w-2xl mb-12">
				<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">Built around how pros actually work</h2>
				<p class="text-lg text-slate-600">
					Service, selection, price, and quality — the four reasons most trade buyers leave their last cabinet
					supplier. We focus on all four.
				</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
				{
					benefits.map((item) => (
						<div>
							<div class="w-12 h-12 rounded-2xl bg-red-50 text-[#C8102E] flex items-center justify-center mb-4">
								<i class={`fa-solid ${item.icon} text-xl`} />
							</div>
							<h3 class="text-xl font-semibold mb-2">{item.title}</h3>
							<p class="text-slate-600">{item.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- How it works -->
	<section class="max-w-7xl mx-auto px-6 py-16 md:py-20">
		<div class="max-w-2xl mb-12">
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">How working with us works</h2>
			<p class="text-lg text-slate-600">Three steps from first call to cabinets on site.</p>
		</div>

		<div class="grid md:grid-cols-3 gap-8">
			{
				steps.map((step) => (
					<div class="border-t-2 border-[#C8102E] pt-6">
						<div class="text-sm font-semibold text-[#C8102E] mb-2">{step.n}</div>
						<h3 class="text-xl font-semibold mb-2">{step.title}</h3>
						<p class="text-slate-600">{step.body}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- Testimonial -->
	<section class="bg-slate-900 text-white py-16 md:py-20">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<i class="fa-solid fa-quote-left text-3xl text-[#C8102E] mb-6"></i>
			<blockquote class="text-xl md:text-2xl font-medium leading-relaxed mb-6">
				“I am a designer and work exclusively with Cabinet Pro Supply for all of my clients’ cabinet needs.
				Their service, pricing and selection are unparalleled. They carry an extensive line of superior
				cabinetry to fit any client’s needs and budget. Ron is a true and knowledgeable professional.”
			</blockquote>
			<footer class="text-red-300 font-semibold">Ellie — Designer, CA</footer>
		</div>
	</section>

	<!-- Brands -->
	<section class="max-w-7xl mx-auto px-6 py-16 md:py-20">
		<div class="text-center mb-10">
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">Brands you can sell with confidence</h2>
			<p class="text-lg text-slate-600 max-w-2xl mx-auto">
				From value stock to fully custom — enough range that you don’t have to send clients somewhere else.
			</p>
		</div>
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 items-center">
			{
				brands.map((brand) => (
					<a
						href={`/brands/${brand.slug}`}
						class="bg-white border border-slate-200 rounded-2xl p-4 h-24 flex items-center justify-center hover:border-slate-300 transition-colors"
					>
						<img src={brand.logo} alt={brand.alt} class={`${brand.logoClass} w-auto object-contain`} />
					</a>
				))
			}
		</div>
		<div class="text-center mt-8">
			<a href="/brands" class="text-[#C8102E] font-semibold hover:underline">Explore all brands →</a>
		</div>
	</section>

	<!-- Soft focus note (from Grok positioning — light touch) -->
	<section class="max-w-7xl mx-auto px-6 pb-4">
		<div class="bg-slate-50 border border-slate-200 rounded-3xl px-8 py-8 md:px-10 md:py-10 max-w-3xl mx-auto text-center">
			<h2 class="text-2xl font-semibold mb-3">Focused on complete kitchen projects</h2>
			<p class="text-slate-600">
				We’re set up to help trade partners deliver full kitchens — new builds and remodels — with the brands
				homeowners already love. If you’re quoting a complete kitchen, we’re ready to move fast.
			</p>
		</div>
	</section>

	<!-- Quote -->
	<section id="quote" class="bg-[#C8102E] py-16 text-white scroll-mt-28 mt-16">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-4xl font-semibold tracking-tight mb-3">Ready for contractor pricing?</h2>
			<p class="text-red-100 text-xl mb-8">
				Tell us about your business or current job — we usually respond within a few hours.
			</p>

			<div class="max-w-md mx-auto bg-white rounded-3xl p-8 text-left shadow-xl">
				<div class="mb-6">
					<h3 class="text-xl font-semibold text-slate-900 mb-1">Request Trade Pricing</h3>
					<p class="text-sm text-slate-600">Fill out the form below and we’ll get back to you shortly.</p>
				</div>
				<div id="hubspot-form">
					<script is:inline src="https://js-na2.hsforms.net/forms/embed/243338171.js" defer></script>
					<div
						class="hs-form-frame"
						data-region="na2"
						data-form-id="33d8738b-cf6c-4b7a-8c52-00d5f5adada7"
						data-portal-id="243338171"
					>
					</div>
				</div>
			</div>

			<p class="text-red-200 text-xs mt-6">
				Your information is secure and will only be used to provide your quote.
			</p>
		</div>
	</section>

	<Footer quoteHref="#quote" />
</BaseLayout>
