---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brands } from '../data/kitchens';
import '../styles/global.css';
---

<BaseLayout
	title="Cabinet Brands | American Name-Brand Kitchen Cabinets | Cabinet Pro Supply"
	description="Explore American cabinet brands from Cabinet Pro Supply — Merit, Lectus, Starmark, Kith, Nations, and Mouser. Stock, semi-custom, and full custom at wholesale pricing."
	canonicalPath="/brands"
>
	<Header />

	<!-- Hero -->
	<section class="bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-6 py-16 md:py-20">
			<div class="max-w-2xl">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-4">BRANDS</div>
				<h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.05] mb-4">
					American cabinet brands for every style and budget
				</h1>
				<p class="text-lg md:text-xl text-slate-300 mb-8">
					From value stock to fully custom — name brands with real warranties, wholesale pricing, and the
					selection to match the kitchen you want.
				</p>
				<a
					href="/contact"
					class="inline-flex px-8 py-4 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-3xl text-lg transition-all active:scale-[0.985]"
				>
					Get a Free Quote
				</a>
			</div>
		</div>
	</section>

	<!-- Intro -->
	<section class="max-w-7xl mx-auto px-6 py-14 md:py-16">
		<div class="max-w-3xl">
			<p class="text-lg text-slate-600">
				We sell lines that have stood the test of time — manufacturers known in the industry for quality,
				warranties, and customer service. You don’t have to give up quality to get a great price on kitchen
				cabinets.
			</p>
		</div>
	</section>

	<!-- Brand cards -->
	<section class="max-w-7xl mx-auto px-6 pb-16 md:pb-20">
		<div class="space-y-10">
			{
				brands.map((brand, i) => (
					<article
						class:list={[
							'grid md:grid-cols-2 gap-0 overflow-hidden rounded-3xl border border-slate-200 bg-white',
							i % 2 === 1 && 'md:[&>div:first-child]:order-2',
						]}
					>
						<div class="relative min-h-[260px] md:min-h-full">
							<img
								src={brand.image}
								alt={brand.imageAlt}
								class="absolute inset-0 w-full h-full object-cover"
							/>
						</div>
						<div class="p-8 md:p-10 flex flex-col">
							<div class="h-16 flex items-center mb-5">
								<img
									src={brand.logo}
									alt={brand.alt}
									class:list={[brand.logoClass, 'w-auto max-w-[200px] object-contain']}
								/>
							</div>
							<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-2">
								{brand.tier}
							</div>
							<h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-3">{brand.name}</h2>
							<p class="text-slate-600 mb-6 flex-1">{brand.blurb}</p>
							<ul class="space-y-2 text-slate-700 mb-8">
								{brand.highlights.map((item) => (
									<li class="flex gap-x-3">
										<i class="fa-solid fa-check mt-1 text-[#C8102E]" />
										<span>{item}</span>
									</li>
								))}
							</ul>
							<div class="flex flex-wrap gap-3">
								<a
									href="/contact"
									class="inline-flex px-5 py-2.5 bg-[#C8102E] hover:bg-[#A50E26] text-white text-sm font-semibold rounded-2xl transition-colors"
								>
									Quote this brand
								</a>
								<a
									href={brand.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex px-5 py-2.5 border border-slate-300 hover:bg-slate-50 text-sm font-semibold rounded-2xl transition-colors"
								>
									Manufacturer site →
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- Stock callout -->
	<section class="bg-slate-50 border-y border-slate-100 py-14">
		<div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
			<div>
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">ALSO AVAILABLE</div>
				<h2 class="text-3xl font-semibold tracking-tight mb-3">CabFabs stock kitchens</h2>
				<p class="text-slate-600 text-lg mb-6">
					Need something in stock and ready to go? Our CabFabs shaker paint line starts at $2,539 for a
					complete 10×10 kitchen — RTA or assembled options available.
				</p>
				<a href="/#kitchens" class="text-[#C8102E] font-semibold hover:underline">
					See kitchen pricing examples →
				</a>
			</div>
			<img
				src="/images/Home-Display-kitchens/stock-white-shaker.webp"
				alt="CabFabs shaker paint kitchen cabinets"
				class="rounded-3xl w-full aspect-[4/3] object-cover border border-slate-200"
			/>
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-[#C8102E] py-16 text-white">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">Not sure which brand fits?</h2>
			<p class="text-red-100 text-xl mb-8">
				Tell us your style, budget, and timeline — we’ll recommend the right line and send a clear quote.
			</p>
			<a
				href="/contact"
				class="inline-flex px-8 py-4 bg-white text-slate-900 font-semibold rounded-3xl text-lg hover:bg-slate-100 transition-colors"
			>
				Request a Free Quote
			</a>
		</div>
	</section>

	<Footer />
</BaseLayout>
