---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import SampleLightbox from '../../../../components/SampleLightbox.astro';
import { getStarmarkDoors } from '../../../../data/starmark-catalog';
import '../../../../styles/global.css';

const doors = getStarmarkDoors('overlay');
---

<BaseLayout
	title={`StarMark Overlay Door Styles | Cabinet Pro Supply`}
	description={`Browse ${doors.length} StarMark overlay door styles. Click any door to enlarge and compare profiles.`}
	canonicalPath="/brands/starmark/doors/overlay"
>
	<Header />

	<section class="bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-6 py-10 md:py-14">
			<nav class="text-sm text-slate-400 mb-5 flex flex-wrap gap-x-2 gap-y-1">
				<a href="/brands" class="hover:text-white transition-colors">Brands</a>
				<span>/</span>
				<a href="/brands/starmark" class="hover:text-white transition-colors">StarMark</a>
				<span>/</span>
				<span class="text-slate-200">Overlay doors</span>
			</nav>
			<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-3">STARMARK · OVERLAY</div>
			<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">Overlay door styles</h1>
			<p class="text-slate-300 max-w-2xl text-lg">
				{doors.length} overlay styles — one natural/unfinished sample per style when available. Click any door to
				enlarge the full profile.
			</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href="/brands/starmark/doors/inset"
					class="inline-flex px-5 py-2.5 border border-white/30 hover:bg-white/10 font-semibold rounded-2xl transition-colors text-sm"
				>
					Inset door styles →
				</a>
				<a
					href="/brands/starmark/finishes"
					class="inline-flex px-5 py-2.5 border border-white/30 hover:bg-white/10 font-semibold rounded-2xl transition-colors text-sm"
				>
					Browse finishes
				</a>
			</div>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-6 py-12 md:py-14">
		<SampleLightbox items={doors} kind="door" />
	</section>

	<section class="bg-[#C8102E] py-14 text-white">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-3xl font-semibold tracking-tight mb-3">Ready to choose a door?</h2>
			<p class="text-red-100 text-lg mb-7">Share your favorites — we’ll quote StarMark with clear wholesale pricing.</p>
			<a
				href="/contact"
				class="inline-flex px-8 py-4 bg-white text-slate-900 font-semibold rounded-3xl text-lg hover:bg-slate-100 transition-colors"
			>
				Request a Free Quote
			</a>
		</div>
	</section>

	<Footer />
</BaseLayout>
