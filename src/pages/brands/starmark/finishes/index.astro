---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import { getStarmarkFinishGroups } from '../../../../data/starmark-catalog';
import '../../../../styles/global.css';

const groups = getStarmarkFinishGroups();
const total = groups.reduce((sum, g) => sum + g.count, 0);
---

<BaseLayout
	title={`StarMark Finishes | Cabinet Pro Supply`}
	description={`Browse ${total} StarMark finish samples by wood species and paint.`}
	canonicalPath="/brands/starmark/finishes"
>
	<Header />

	<section class="bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-6 py-10 md:py-14">
			<nav class="text-sm text-slate-400 mb-5 flex flex-wrap gap-x-2 gap-y-1">
				<a href="/brands" class="hover:text-white transition-colors">Brands</a>
				<span>/</span>
				<a href="/brands/starmark" class="hover:text-white transition-colors">StarMark</a>
				<span>/</span>
				<span class="text-slate-200">Finishes</span>
			</nav>
			<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-3">STARMARK · FINISHES</div>
			<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">Finishes by species</h1>
			<p class="text-slate-300 max-w-2xl text-lg">
				{total} finish samples grouped the way the original catalog was organized — paint as its own group, then wood
				species. Open a group to browse and enlarge swatches.
			</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href="/brands/starmark/doors/overlay"
					class="inline-flex px-5 py-2.5 border border-white/30 hover:bg-white/10 font-semibold rounded-2xl transition-colors text-sm"
				>
					Overlay doors
				</a>
				<a
					href="/brands/starmark/doors/inset"
					class="inline-flex px-5 py-2.5 border border-white/30 hover:bg-white/10 font-semibold rounded-2xl transition-colors text-sm"
				>
					Inset doors
				</a>
			</div>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-6 py-12 md:py-14">
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
			{
				groups.map((group) => {
					const preview = group.items[0];
					return (
						<a
							href={`/brands/starmark/finishes/${group.slug}`}
							class="rounded-3xl border border-slate-200 bg-white overflow-hidden hover:border-slate-300 hover:shadow-sm transition-all"
						>
							<div class="aspect-[16/10] bg-slate-50">
								{preview && (
									<img src={preview.src} alt="" class="w-full h-full object-cover" loading="lazy" />
								)}
							</div>
							<div class="p-5">
								<div class="flex items-baseline justify-between gap-3 mb-1">
									<h2 class="text-xl font-semibold text-slate-900">{group.name}</h2>
									<span class="text-sm font-medium text-slate-500">{group.count}</span>
								</div>
								<p class="text-slate-600 text-sm leading-relaxed">{group.description}</p>
								<div class="mt-3 text-sm font-semibold text-[#C8102E]">Browse {group.name.toLowerCase()} →</div>
							</div>
						</a>
					);
				})
			}
		</div>
	</section>

	<section class="bg-[#C8102E] py-14 text-white">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-3xl font-semibold tracking-tight mb-3">Need help picking a finish?</h2>
			<p class="text-red-100 text-lg mb-7">We’ll pull current StarMark options for your door style and wood.</p>
			<a
				href="/contact"
				class="inline-flex px-8 py-4 bg-white text-slate-900 font-semibold rounded-3xl text-lg hover:bg-slate-100 transition-colors"
			>
				Request a Free Quote
			</a>
		</div>
	</section>

	<Footer />
</BaseLayout>
