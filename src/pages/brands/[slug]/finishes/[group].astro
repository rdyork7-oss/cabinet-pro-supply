---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import SampleLightbox from '../../../../components/SampleLightbox.astro';
import { getBrandBySlug } from '../../../../data/brands';
import {
	catalogBrandSlugs,
	getBrandCatalog,
	getCatalogFinishGroup,
	getCatalogFinishGroups,
} from '../../../../data/brand-catalog';
import '../../../../styles/global.css';

export function getStaticPaths() {
	return catalogBrandSlugs.flatMap((slug) => {
		const groups = getCatalogFinishGroups(slug);
		return groups.map((group) => ({
			params: { slug, group: group.slug },
		}));
	});
}

const { slug, group: groupSlug } = Astro.params;
const brand = getBrandBySlug(slug!);
const catalog = getBrandCatalog(slug!);
const group = getCatalogFinishGroup(slug!, groupSlug!);

if (!brand || !catalog || !group) {
	return Astro.redirect(brand ? `/brands/${brand.slug}/finishes` : '/brands');
}

const otherGroups = getCatalogFinishGroups(slug!).filter((g) => g.slug !== group.slug);
---

<BaseLayout
	title={`${brand.name} ${group.name} Finishes | Cabinet Pro Supply`}
	description={`Browse ${group.count} ${brand.name} ${group.name.toLowerCase()} finish samples. Click to enlarge.`}
	canonicalPath={`/brands/${brand.slug}/finishes/${group.slug}`}
>
	<Header />

	<section class="bg-slate-900 text-white">
		<div class="max-w-7xl mx-auto px-6 py-10 md:py-14">
			<nav class="text-sm text-slate-400 mb-5 flex flex-wrap gap-x-2 gap-y-1">
				<a href="/brands" class="hover:text-white transition-colors">Brands</a>
				<span>/</span>
				<a href={`/brands/${brand.slug}`} class="hover:text-white transition-colors">{brand.name}</a>
				<span>/</span>
				<a href={`/brands/${brand.slug}/finishes`} class="hover:text-white transition-colors">Finishes</a>
				<span>/</span>
				<span class="text-slate-200">{group.name}</span>
			</nav>
			<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-3">
				{brand.name.toUpperCase()} · FINISHES
			</div>
			<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">{group.name} finishes</h1>
			<p class="text-slate-300 max-w-2xl text-lg">
				{group.count} samples. {group.description} Click any swatch to enlarge.
			</p>
		</div>
	</section>

	<section class="max-w-7xl mx-auto px-6 py-12 md:py-14">
		<SampleLightbox
			items={group.items}
			kind="finish"
			columns="grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6"
		/>

		{
			otherGroups.length > 0 && (
				<div class="mt-14 pt-10 border-t border-slate-200">
					<h2 class="text-xl font-semibold tracking-tight mb-5">Other finish groups</h2>
					<div class="flex flex-wrap gap-3">
						{otherGroups.map((g) => (
							<a
								href={`/brands/${brand.slug}/finishes/${g.slug}`}
								class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 hover:border-slate-300"
							>
								{g.name}
								<span class="text-slate-400">{g.count}</span>
							</a>
						))}
						<a
							href={`/brands/${brand.slug}/finishes`}
							class="inline-flex items-center rounded-2xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-[#C8102E]"
						>
							All groups →
						</a>
					</div>
				</div>
			)
		}
	</section>

	<section class="bg-[#C8102E] py-14 text-white">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-3xl font-semibold tracking-tight mb-3">Found a finish you like?</h2>
			<p class="text-red-100 text-lg mb-7">
				Tell us the door style — we’ll quote {brand.name} for your project.
			</p>
			<a
				href="/contact"
				class="inline-flex px-8 py-4 bg-white text-slate-900 font-semibold rounded-3xl text-lg hover:bg-slate-100 transition-colors"
			>
				Request a Free Quote
			</a>
		</div>
	</section>

	<Footer />
</BaseLayout>
