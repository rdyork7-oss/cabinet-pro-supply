---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { brands, getBrandBySlug, hasBrandCatalog } from '../../data/brands';
import '../../styles/global.css';

export function getStaticPaths() {
	return brands.map((brand) => ({
		params: { slug: brand.slug },
	}));
}

const { slug } = Astro.params;
const brand = getBrandBySlug(slug!);

if (!brand) {
	return Astro.redirect('/brands');
}

const otherBrands = brands.filter((b) => b.slug !== brand.slug);
const hasSamples = brand.finishes.length > 0 || brand.doors.length > 0;
const isStarmark = brand.slug === 'starmark';
const hasCatalog = hasBrandCatalog(brand.slug);
const doorsHref = isStarmark ? '/brands/starmark/doors/overlay' : `/brands/${brand.slug}/doors`;
const finishesHref = `/brands/${brand.slug}/finishes`;
---

<BaseLayout
	title={`${brand.name} Cabinets | Cabinet Pro Supply`}
	description={`${brand.blurb} Wholesale pricing and design help from Cabinet Pro Supply.`}
	canonicalPath={`/brands/${brand.slug}`}
>
	<Header />

	<!-- Hero -->
	<section class="relative overflow-hidden bg-slate-900 text-white">
		<div
			class="absolute inset-0 opacity-30"
			style={`background-image: url('${brand.image}'); background-size: cover; background-position: center;`}
		>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/92 to-slate-900/70"></div>

		<div class="relative max-w-7xl mx-auto px-6 py-16 md:py-24">
			<a
				href="/brands"
				class="inline-flex items-center gap-x-2 text-sm text-slate-300 hover:text-white mb-6 transition-colors"
			>
				<i class="fa-solid fa-arrow-left text-xs"></i>
				All brands
			</a>

			<div class="grid md:grid-cols-2 gap-10 items-end">
				<div class="max-w-xl">
					<div class="uppercase tracking-[2px] text-xs font-semibold text-red-400 mb-3">{brand.tier}</div>
					<div class="inline-flex h-16 items-center mb-5 rounded-2xl bg-white px-5 py-3">
						<img
							src={brand.logo}
							alt={brand.alt}
							class:list={[brand.logoClass, 'w-auto max-w-[200px] object-contain']}
						/>
					</div>
					<h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.05] mb-4">
						{brand.name}
					</h1>
					<p class="text-lg text-slate-300 mb-8">{brand.blurb}</p>
					<div class="flex flex-wrap gap-3">
						<a
							href="/contact"
							class="inline-flex px-7 py-3.5 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-3xl transition-all active:scale-[0.985]"
						>
							Get a Free Quote
						</a>
						<a
							href={brand.url}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex px-7 py-3.5 border border-white/30 hover:bg-white/10 font-semibold rounded-3xl transition-colors"
						>
							Manufacturer site →
						</a>
					</div>
				</div>

				{
					brand.examplePrice && (
						<div class="bg-white/10 backdrop-blur border border-white/15 rounded-3xl p-6 md:p-7 max-w-sm md:ml-auto">
							<div class="uppercase tracking-[2px] text-xs font-semibold text-red-300 mb-2">
								EXAMPLE 10×10 PRICING
							</div>
							<div class="text-sm text-slate-300 mb-1">{brand.exampleName}</div>
							<div class="text-4xl font-semibold text-white mb-3">{brand.examplePrice}</div>
							<p class="text-sm text-slate-400 mb-4">
								Wholesale example for a complete 10×10 kitchen. Your layout, finishes, and options will change
								the final quote.
							</p>
							<a href="/#kitchens" class="text-sm font-semibold text-white hover:underline">
								See all pricing examples →
							</a>
						</div>
					)
				}
			</div>
		</div>
	</section>

	<!-- About -->
	<section class="max-w-7xl mx-auto px-6 py-14 md:py-16">
		<div class="grid md:grid-cols-2 gap-10 md:gap-14 items-start">
			<div>
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">ABOUT THIS LINE</div>
				<h2 class="text-3xl font-semibold tracking-tight mb-4">Why choose {brand.name}</h2>
				<p class="text-lg text-slate-600 leading-relaxed">{brand.description}</p>
			</div>
			<div class="rounded-3xl overflow-hidden border border-slate-200 bg-slate-100 aspect-[4/3]">
				<img src={brand.image} alt={brand.imageAlt} class="w-full h-full object-cover" />
			</div>
		</div>
	</section>

	<!-- Highlights -->
	<section class="bg-slate-50 border-y border-slate-100 py-14">
		<div class="max-w-7xl mx-auto px-6">
			<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">AT A GLANCE</div>
			<h2 class="text-3xl font-semibold tracking-tight mb-8">Key highlights</h2>
			<ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{
					brand.highlights.map((item) => (
						<li class="flex gap-x-3 bg-white border border-slate-200 rounded-2xl px-5 py-4 text-slate-800">
							<i class="fa-solid fa-check mt-0.5 text-[#C8102E]" />
							<span class="font-medium">{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Best for + Construction -->
	<section class="max-w-7xl mx-auto px-6 py-14 md:py-16">
		<div class="grid md:grid-cols-2 gap-10">
			<div class="rounded-3xl border border-slate-200 bg-white p-8 md:p-10">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">BEST FOR</div>
				<h2 class="text-2xl font-semibold tracking-tight mb-5">Ideal projects</h2>
				<ul class="space-y-3 text-slate-700">
					{
						brand.bestFor.map((item) => (
							<li class="flex gap-x-3">
								<i class="fa-solid fa-circle-check mt-1 text-[#C8102E]" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="rounded-3xl border border-slate-200 bg-white p-8 md:p-10">
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">CONSTRUCTION</div>
				<h2 class="text-2xl font-semibold tracking-tight mb-5">How it’s built</h2>
				<ul class="space-y-3 text-slate-700">
					{
						brand.construction.map((item) => (
							<li class="flex gap-x-3">
								<i class="fa-solid fa-screwdriver-wrench mt-1 text-[#C8102E]" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- Door / finish samples or scaffold note -->
	<section class="max-w-7xl mx-auto px-6 pb-14 md:pb-16">
		{
			hasCatalog ? (
				<div>
					<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">DOOR & FINISH CATALOG</div>
					<h2 class="text-3xl font-semibold tracking-tight mb-3">Browse {brand.name} styles</h2>
					{brand.samplesNote && <p class="text-slate-600 mb-8 max-w-3xl">{brand.samplesNote}</p>}

					<div class:list={['grid gap-4 mb-12', isStarmark ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
						{isStarmark ? (
							<>
								<a
									href="/brands/starmark/doors/inset"
									class="rounded-3xl border border-slate-200 bg-white p-6 hover:border-slate-300 hover:shadow-sm transition-all"
								>
									<div class="text-xs font-semibold tracking-[2px] uppercase text-[#C8102E] mb-2">INSET</div>
									<div class="text-xl font-semibold text-slate-900 mb-1">Inset door styles</div>
									<p class="text-sm text-slate-600 mb-3">Full doors, click to enlarge</p>
									<span class="text-sm font-semibold text-[#C8102E]">View inset catalog →</span>
								</a>
								<a
									href="/brands/starmark/doors/overlay"
									class="rounded-3xl border border-slate-200 bg-white p-6 hover:border-slate-300 hover:shadow-sm transition-all"
								>
									<div class="text-xs font-semibold tracking-[2px] uppercase text-[#C8102E] mb-2">OVERLAY</div>
									<div class="text-xl font-semibold text-slate-900 mb-1">Overlay door styles</div>
									<p class="text-sm text-slate-600 mb-3">One sample per style</p>
									<span class="text-sm font-semibold text-[#C8102E]">View overlay catalog →</span>
								</a>
							</>
						) : (
							<a
								href={doorsHref}
								class="rounded-3xl border border-slate-200 bg-white p-6 hover:border-slate-300 hover:shadow-sm transition-all"
							>
								<div class="text-xs font-semibold tracking-[2px] uppercase text-[#C8102E] mb-2">DOORS</div>
								<div class="text-xl font-semibold text-slate-900 mb-1">Door styles</div>
								<p class="text-sm text-slate-600 mb-3">Full doors, click to enlarge</p>
								<span class="text-sm font-semibold text-[#C8102E]">View door catalog →</span>
							</a>
						)}
						<a
							href={finishesHref}
							class="rounded-3xl border border-slate-200 bg-white p-6 hover:border-slate-300 hover:shadow-sm transition-all"
						>
							<div class="text-xs font-semibold tracking-[2px] uppercase text-[#C8102E] mb-2">FINISHES</div>
							<div class="text-xl font-semibold text-slate-900 mb-1">Browse finishes</div>
							<p class="text-sm text-slate-600 mb-3">Paint, wood & material groups</p>
							<span class="text-sm font-semibold text-[#C8102E]">View finish catalog →</span>
						</a>
					</div>

					{brand.doors.length > 0 && (
						<div class="mb-12">
							<div class="flex flex-wrap items-end justify-between gap-3 mb-5">
								<h3 class="text-xl font-semibold">Door style preview</h3>
								<a href={doorsHref} class="text-sm font-semibold text-[#C8102E] hover:underline">
									See all doors →
								</a>
							</div>
							<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
								{brand.doors.map((door) => (
									<figure class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
										<div class="h-48 bg-slate-50 flex items-center justify-center p-3">
											<img
												src={door.src}
												alt={`${door.name} door style`}
												class="max-h-full max-w-full object-contain"
											/>
										</div>
										<figcaption class="px-3 py-2.5 text-sm">
											<div class="font-medium text-slate-900">{door.name}</div>
											{door.category && <div class="text-xs text-slate-500">{door.category}</div>}
										</figcaption>
									</figure>
								))}
							</div>
						</div>
					)}

					{brand.finishes.length > 0 && (
						<div>
							<div class="flex flex-wrap items-end justify-between gap-3 mb-5">
								<h3 class="text-xl font-semibold">Finish preview</h3>
								<a href={finishesHref} class="text-sm font-semibold text-[#C8102E] hover:underline">
									See all finishes →
								</a>
							</div>
							<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
								{brand.finishes.map((finish) => (
									<figure class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
										<div class="aspect-square bg-slate-50">
											<img
												src={finish.src}
												alt={`${finish.name} finish sample`}
												class="w-full h-full object-cover"
											/>
										</div>
										<figcaption class="px-3 py-2.5 text-sm font-medium text-slate-900">{finish.name}</figcaption>
									</figure>
								))}
							</div>
						</div>
					)}
				</div>
			) : hasSamples ? (
				<div>
					<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">SAMPLES</div>
					<h2 class="text-3xl font-semibold tracking-tight mb-3">Door & finish examples</h2>
					{brand.samplesNote && <p class="text-slate-600 mb-8 max-w-3xl">{brand.samplesNote}</p>}

					{brand.doors.length > 0 && (
						<div class="mb-12">
							<h3 class="text-xl font-semibold mb-5">Door styles</h3>
							<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
								{brand.doors.map((door) => (
									<figure class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
										<div class="aspect-square bg-slate-50">
											<img src={door.src} alt={`${door.name} door style`} class="w-full h-full object-cover" />
										</div>
										<figcaption class="px-3 py-2.5 text-sm">
											<div class="font-medium text-slate-900">{door.name}</div>
											{door.category && <div class="text-xs text-slate-500">{door.category}</div>}
										</figcaption>
									</figure>
								))}
							</div>
						</div>
					)}

					{brand.finishes.length > 0 && (
						<div>
							<h3 class="text-xl font-semibold mb-5">Finish examples</h3>
							<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
								{brand.finishes.map((finish) => (
									<figure class="rounded-2xl border border-slate-200 bg-white overflow-hidden">
										<div class="aspect-square bg-slate-50">
											<img
												src={finish.src}
												alt={`${finish.name} finish sample`}
												class="w-full h-full object-cover"
											/>
										</div>
										<figcaption class="px-3 py-2.5 text-sm font-medium text-slate-900">{finish.name}</figcaption>
									</figure>
								))}
							</div>
						</div>
					)}
				</div>
			) : (
				<div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-8 py-10 md:px-10">
					<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">DOOR & FINISH OPTIONS</div>
					<h2 class="text-2xl font-semibold tracking-tight mb-3">Current samples available on request</h2>
					<p class="text-slate-600 max-w-2xl mb-6">
						{brand.optionsNote ??
							'Ask us for current door styles and finish options from the manufacturer dealer portal.'}
					</p>
					<a
						href="/contact"
						class="inline-flex px-6 py-3 bg-[#C8102E] hover:bg-[#A50E26] text-white font-semibold rounded-2xl transition-colors"
					>
						Request current options
					</a>
				</div>
			)
		}
	</section>

	<!-- Gallery (temporary CPS kitchen heroes) -->
	{
		brand.gallery.length > 0 && (
			<section class="bg-slate-50 border-y border-slate-100 py-14">
				<div class="max-w-7xl mx-auto px-6">
					<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">INSPIRATION</div>
					<h2 class="text-3xl font-semibold tracking-tight mb-3">Kitchen examples</h2>
					<p class="text-slate-600 mb-8 max-w-2xl">
						Display photos from our catalog for reference. Updated manufacturer or dealer showroom photography can
						replace these as assets become available.
					</p>
					<div class:list={['grid gap-5', brand.gallery.length > 1 ? 'md:grid-cols-2' : 'max-w-3xl']}>
						{brand.gallery.map((img) => (
							<figure class="rounded-3xl overflow-hidden border border-slate-200 bg-white">
								<img src={img.src} alt={img.alt} class="w-full aspect-[4/3] object-cover" />
								<figcaption class="px-5 py-3 text-sm text-slate-600">{img.alt}</figcaption>
							</figure>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- Other brands -->
	<section class="max-w-7xl mx-auto px-6 py-14 md:py-16">
		<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
			<div>
				<div class="uppercase tracking-[2px] text-xs font-semibold text-[#C8102E] mb-3">MORE LINES</div>
				<h2 class="text-3xl font-semibold tracking-tight">Other brands we sell</h2>
			</div>
			<a href="/brands" class="text-[#C8102E] font-semibold hover:underline">View all brands →</a>
		</div>
		<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
			{
				otherBrands.map((b) => (
					<a
						href={`/brands/${b.slug}`}
						class="rounded-2xl border border-slate-200 bg-white p-4 flex flex-col items-center text-center hover:border-slate-300 hover:shadow-sm transition-all"
					>
						<div class="h-14 flex items-center justify-center mb-3 w-full">
							<img
								src={b.logo}
								alt={b.alt}
								class:list={[b.logoClass, 'w-auto max-h-12 max-w-full object-contain']}
							/>
						</div>
						<span class="text-sm font-semibold text-slate-900">{b.name}</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-[#C8102E] py-16 text-white">
		<div class="max-w-3xl mx-auto px-6 text-center">
			<h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-3">Ready to quote {brand.name}?</h2>
			<p class="text-red-100 text-xl mb-8">
				Share your layout, style preferences, and timeline — we’ll send clear options and wholesale pricing.
			</p>
			<a
				href="/contact"
				class="inline-flex px-8 py-4 bg-white text-slate-900 font-semibold rounded-3xl text-lg hover:bg-slate-100 transition-colors"
			>
				Request a Free Quote
			</a>
		</div>
	</section>

	<Footer />
</BaseLayout>
