---
interface Item {
	src: string;
	name: string;
	slug?: string;
}

interface Props {
	items: Item[];
	kind?: 'door' | 'finish';
	columns?: string;
}

const { items, kind = 'door', columns = 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5' } =
	Astro.props;

const isDoor = kind === 'door';
---

<div
	class:list={['sample-grid grid gap-4', columns]}
	data-lightbox-grid
	data-lightbox-kind={kind}
>
	{
		items.map((item, index) => (
			<button
				type="button"
				class="group text-left rounded-2xl border border-slate-200 bg-white overflow-hidden hover:border-slate-300 hover:shadow-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#C8102E] focus-visible:ring-offset-2"
				data-lightbox-open
				data-index={index}
				data-src={item.src}
				data-name={item.name}
				aria-label={`Enlarge ${item.name}`}
			>
				<div
					class:list={[
						'bg-slate-50 flex items-center justify-center p-3 sm:p-4',
						isDoor ? 'h-64 sm:h-72' : 'aspect-square',
					]}
				>
					<img
						src={item.src}
						alt={item.name}
						class:list={['max-h-full max-w-full', isDoor ? 'object-contain' : 'object-cover w-full h-full rounded-lg']}
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div class="px-3 py-2.5 border-t border-slate-100">
					<div class="text-sm font-medium text-slate-900 leading-snug">{item.name}</div>
					<div class="text-xs text-slate-500 mt-0.5 group-hover:text-[#C8102E] transition-colors">
						Click to enlarge
					</div>
				</div>
			</button>
		))
	}
</div>

<dialog
	class="lightbox-dialog fixed inset-0 z-[80] m-0 max-w-none max-h-none w-full h-full bg-slate-950/80 p-0 backdrop:bg-transparent"
	data-lightbox-dialog
	aria-label="Enlarged sample"
>
	<div class="flex h-full w-full items-center justify-center p-4 sm:p-8">
		<div
			class="relative w-full max-w-4xl rounded-3xl bg-white shadow-2xl overflow-hidden"
			data-lightbox-panel
		>
			<div class="flex items-start justify-between gap-4 border-b border-slate-100 px-5 py-4">
				<div>
					<div class="text-lg font-semibold text-slate-900" data-lightbox-title></div>
					<div class="text-sm text-slate-500" data-lightbox-count></div>
				</div>
				<button
					type="button"
					class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50"
					data-lightbox-close
					aria-label="Close enlarged view"
				>
					<i class="fa-solid fa-xmark"></i>
				</button>
			</div>
			<div class="bg-slate-50 flex items-center justify-center min-h-[50vh] max-h-[75vh] p-6">
				<img
					src=""
					alt=""
					class="max-h-[70vh] max-w-full object-contain"
					data-lightbox-image
				/>
			</div>
			<div class="flex items-center justify-between gap-3 border-t border-slate-100 px-5 py-3">
				<button
					type="button"
					class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40"
					data-lightbox-prev
					aria-label="Previous sample"
				>
					<i class="fa-solid fa-arrow-left text-xs"></i>
					Prev
				</button>
				<button
					type="button"
					class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40"
					data-lightbox-next
					aria-label="Next sample"
				>
					Next
					<i class="fa-solid fa-arrow-right text-xs"></i>
				</button>
			</div>
		</div>
	</div>
</dialog>

<style>
	.lightbox-dialog[open] {
		display: flex;
	}
</style>

<script>
	function initLightbox(root = document) {
		const grids = root.querySelectorAll('[data-lightbox-grid]');
		grids.forEach((grid) => {
			if (grid instanceof HTMLElement && grid.dataset.lightboxReady === '1') return;
			if (grid instanceof HTMLElement) grid.dataset.lightboxReady = '1';

			const dialog = grid.parentElement?.querySelector('[data-lightbox-dialog]');
			if (!(dialog instanceof HTMLDialogElement)) return;

			const titleEl = dialog.querySelector('[data-lightbox-title]');
			const countEl = dialog.querySelector('[data-lightbox-count]');
			const imageEl = dialog.querySelector('[data-lightbox-image]');
			const prevBtn = dialog.querySelector('[data-lightbox-prev]');
			const nextBtn = dialog.querySelector('[data-lightbox-next]');
			const closeBtn = dialog.querySelector('[data-lightbox-close]');
			const panel = dialog.querySelector('[data-lightbox-panel]');

			const buttons = Array.from(grid.querySelectorAll('[data-lightbox-open]'));
			let index = 0;

			function show(i) {
				index = (i + buttons.length) % buttons.length;
				const btn = buttons[index];
				if (!(btn instanceof HTMLElement)) return;
				const src = btn.dataset.src || '';
				const name = btn.dataset.name || '';
				if (imageEl instanceof HTMLImageElement) {
					imageEl.src = src;
					imageEl.alt = name;
				}
				if (titleEl) titleEl.textContent = name;
				if (countEl) countEl.textContent = `${index + 1} of ${buttons.length}`;
				if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = buttons.length < 2;
				if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = buttons.length < 2;
			}

			function open(i) {
				show(i);
				dialog.showModal();
				if (closeBtn instanceof HTMLElement) closeBtn.focus();
			}

			function close() {
				dialog.close();
			}

			buttons.forEach((btn, i) => {
				btn.addEventListener('click', () => open(i));
			});
			prevBtn?.addEventListener('click', () => show(index - 1));
			nextBtn?.addEventListener('click', () => show(index + 1));
			closeBtn?.addEventListener('click', close);

			dialog.addEventListener('click', (e) => {
				if (panel && e.target instanceof Node && !panel.contains(e.target)) close();
			});

			dialog.addEventListener('keydown', (e) => {
				if (!(e instanceof KeyboardEvent)) return;
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					show(index - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					show(index + 1);
				}
			});
		});
	}

	initLightbox();
	document.addEventListener('astro:page-load', () => initLightbox());
</script>
