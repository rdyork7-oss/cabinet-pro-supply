---
interface Props {
	quoteHref?: string;
}

const { quoteHref = '/contact' } = Astro.props;
---

<footer class="bg-slate-900 text-slate-400 py-12">
	<div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-y-10">
		<div class="md:col-span-1">
			<a href="/" class="inline-block mb-4 rounded-2xl bg-white p-3 shadow-sm">
				<img
					src="/images/cabinet-pro-supply-logo-footer.png"
					alt="Cabinet Pro Supply — The right way to buy cabinets"
					class="h-11 w-auto max-w-[260px]"
				/>
			</a>
			<p class="max-w-xs">Wholesale American-made cabinets for trade professionals and homeowners.</p>
		</div>

		<div class="text-sm">
			<div class="font-semibold text-white mb-3">Contact</div>
			<a href="tel:18774777784" class="block hover:text-white transition-colors">1-877-477-7784</a>
			<a href="mailto:info@cabinetprosupply.com" class="block hover:text-white transition-colors">
				info@cabinetprosupply.com
			</a>
		</div>

		<div class="text-sm">
			<div class="font-semibold text-white mb-3">Quick Links</div>
			<a href="/pros" class="block hover:text-white transition-colors">For Pros</a>
			<a href="/diy" class="block hover:text-white transition-colors mt-1">For DIY</a>
			<a href="/brands" class="block hover:text-white transition-colors mt-1">Brands</a>
			<a href="/about" class="block hover:text-white transition-colors mt-1">About Us</a>
			<a href="/contact" class="block hover:text-white transition-colors mt-1">Contact</a>
			<a
				href="https://www.cabinetprosupply.com/cps-blog.html"
				class="block hover:text-white transition-colors mt-1">Blog</a
			>
			<div class="mt-3">Davenport, Florida</div>
			<div class="mt-1">Nationwide Delivery</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-6 mt-12 pt-8 border-t border-slate-800 text-xs text-center text-slate-500">
		© {new Date().getFullYear()} Cabinet Pro Supply. All rights reserved.
	</div>
</footer>

<div
	class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white border-t border-slate-200 px-4 py-3 flex gap-3 shadow-lg"
>
	<a
		href="tel:18774777784"
		class="flex-1 py-3 border border-slate-300 rounded-2xl font-semibold text-center text-sm flex items-center justify-center gap-2"
	>
		<i class="fa-solid fa-phone text-[#C8102E]"></i> Call
	</a>
	<a
		href={quoteHref}
		class="flex-1 py-3 bg-[#C8102E] text-white rounded-2xl font-semibold text-center text-sm"
	>
		Get Quote
	</a>
</div>
